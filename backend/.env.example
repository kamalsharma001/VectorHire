# VectorHire Backend Configuration Template
# Copy this file to .env and configure your environment variables.

# Core Service Settings
APP_NAME=VectorHire
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Primary LLM Provider: Google Gemini
# Options: "gemini" (recommended default) or "groq"
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash
GEMINI_TEMPERATURE=0.1
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=3

# Cross-Provider Fallback: Groq Cloud
# Automatically engaged if Gemini encounters rate limits (429), quota exhaustion, or service outages.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.1
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_RETRIES=3
GROQ_MAX_TOKENS=1000

# Local Embedding Model (FastEmbed / ONNX)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32

# Operational Safeguards
UNCERTAINTY_DISCOUNT_GAMMA=0.50
MAX_BATCH_SIZE=10
MAX_FILE_SIZE_MB=10
MAX_CONCURRENT_REQUESTS=3
